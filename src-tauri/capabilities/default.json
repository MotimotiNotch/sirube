{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Sirube が必要とする最小の権限。ユーザーが選んだ vault フォルダの読み書き・監視、フォルダ選択ダイアログ、そして「今どの vault を開いているか」をアプリのデータフォルダへ書き出すこと。",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$APPLOCALDATA/vault-path.txt"
        }
      ]
    }
  ]
}
