{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Sirube が必要とする最小の権限。別窓（sub-*）も同じ権限で開き、本窓から開いたり閉じたりする。ユーザーが選んだ vault フォルダの読み書き・監視、フォルダ選択ダイアログ、リンクを既定のブラウザで開くこと（http/https のみ）、そして「今どの vault を開いているか」をアプリのデータフォルダへ書き出すこと。",
  "windows": [
    "main",
    "sub-*"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-destroy",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" }
      ]
    },
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$APPLOCALDATA/vault-path.txt"
        }
      ]
    }
  ]
}
