{
  "name": "sirube",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "目的から「それには何が必要か」を辿ると、末端に今日できることが現れる。半年空けても、道は残っている。",
  "scripts": {
    "dev": "bun run src/dev/serve.ts",
    "build:web": "bun run scripts/build-web.ts",
    "tauri": "tauri",
    "release": "bun run scripts/release.ts",
    "release:linux": "sh scripts/linux/build-appimage.sh",
    "icons": "bun run scripts/gen-icons.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "agents-doc": "bun run scripts/gen-agents-doc.ts",
    "manual-doc": "bun run scripts/gen-manual-doc.ts",
    "test-doc": "bun run scripts/gen-test-doc.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "js-yaml": "^4.1.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.12.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
